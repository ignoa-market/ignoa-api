    }
  ],
  "panels": [
    {
      "type": "timeseries",
      "title": "결제 API 요청량·HTTP 오류",
      "description": "결제 준비·승인 API별 전체 요청과 4xx·5xx의 초당 건수. 전체 요청에는 오류도 포함. HTTP 200도 결제 성공을 보장하지 않음. 메인 서버에서 UNKNOWN으로 변환한 외부 오류는 HTTP 5xx와 다를 수 있음.",
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "eg0q0rxkuivwgc"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "noValue": "수집 확인 필요"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eg0q0rxkuivwgc"
          },
          "refId": "A",
          "expr": "sum by (method, uri) (rate(http_server_requests_seconds_count{application=\"ignoa-api\", uri=~\"/api/trades/[^/]+/payments(/confirm)?\"}[$__rate_interval]))",
          "range": true,
          "instant": false,
          "legendFormat": "전체 {{uri}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eg0q0rxkuivwgc"
          },
          "refId": "B",
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{application=\"ignoa-api\", uri=~\"/api/trades/[^/]+/payments(/confirm)?\", status=~\"4..\"}[$__rate_interval])) or (0 * sum by (uri) (rate(http_server_requests_seconds_count{application=\"ignoa-api\", uri=~\"/api/trades/[^/]+/payments(/confirm)?\"}[$__rate_interval])))",
          "range": true,
          "instant": false,
          "legendFormat": "4xx {{uri}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eg0q0rxkuivwgc"
          },
          "refId": "C",
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{application=\"ignoa-api\", uri=~\"/api/trades/[^/]+/payments(/confirm)?\", status=~\"5..\"}[$__rate_interval])) or (0 * sum by (uri) (rate(http_server_requests_seconds_count{application=\"ignoa-api\", uri=~\"/api/trades/[^/]+/payments(/confirm)?\"}[$__rate_interval])))",
          "range": true,
          "instant": false,
          "legendFormat": "5xx {{uri}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "결제 준비 API 응답 시간 p50 / p95 / p99",
      "description": "POST /api/trades/{tradeId}/payments 전체 서버 처리 시간. 오류 응답 포함. 거래 생성·Toss 결제창 사용자 조작 시간은 제외.",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "eg0q0rxkuivwgc"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "noValue": "최근 요청 없음 / 히스토그램 확인"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eg0q0rxkuivwgc"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"ignoa-api\", uri=\"/api/trades/{tradeId}/payments\", method=\"POST\"}[$__rate_interval])))",
          "range": true,
          "instant": false,
          "legendFormat": "p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eg0q0rxkuivwgc"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"ignoa-api\", uri=\"/api/trades/{tradeId}/payments\", method=\"POST\"}[$__rate_interval])))",
          "range": true,
          "instant": false,
          "legendFormat": "p95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eg0q0rxkuivwgc"
          },
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"ignoa-api\", uri=\"/api/trades/{tradeId}/payments\", method=\"POST\"}[$__rate_interval])))",
          "range": true,
          "instant": false,
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "결제 승인 API 응답 시간 p50 / p95 / p99",
      "description": "승인 요청의 서버 처리 시간. UNKNOWN 이후 콜백·복구 대기 시간과 브라우저 네트워크 시간은 제외. HTTP 오류 포함.",
