    {
      "type": "stat",
      "title": "api",
      "description": "Alloy가 /actuator/prometheus를 가져오는 데 성공하면 UP. '수집 안 됨'이면 EC2나 Alloy 자체가 멈춘 것일 수 있음",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "eg0q0rxkuivwgc"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "수집 안 됨",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "color": "green"
                },
                "0": {
                  "text": "DOWN",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eg0q0rxkuivwgc"
          },
          "refId": "A",
          "expr": "up{job=\"ignoa-api\"}",
          "instant": true
        }
      ]
    },
