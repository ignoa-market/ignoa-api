    {
      "type": "timeseries",
      "title": "초당 요청 수",
      "description": "/actuator 요청(헬스체크·지표 수집)은 제외",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "eg0q0rxkuivwgc"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eg0q0rxkuivwgc"
          },
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"ignoa-api\", uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "전체",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eg0q0rxkuivwgc"
          },
          "refId": "B",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"ignoa-api\", uri!~\"/actuator.*\", status=~\"5..\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "5xx",
          "range": true
        }
      ]
    },
