    {
      "type": "timeseries",
      "title": "초당 요청 수 (응답별)",
      "description": "/actuator 요청은 제외. 2xx에는 3xx를 포함",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "eg0q0rxkuivwgc"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: RPS",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 30,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "2xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "4xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "5xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eg0q0rxkuivwgc"
          },
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"ignoa-api\", uri!~\"/actuator.*\", status=~\"2..|3..\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "2xx",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eg0q0rxkuivwgc"
          },
          "refId": "B",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"ignoa-api\", uri!~\"/actuator.*\", status=~\"4..\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "4xx",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eg0q0rxkuivwgc"
          },
          "refId": "C",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"ignoa-api\", uri!~\"/actuator.*\", status=~\"5..\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "5xx",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "5xx 비율",
      "description": "/actuator 요청은 제외. 요청이 없으면 0",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "eg0q0rxkuivwgc"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "max": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eg0q0rxkuivwgc"
          },
          "refId": "A",
          "expr": "((sum(rate(http_server_requests_seconds_count{job=\"ignoa-api\", uri!~\"/actuator.*\", status=~\"5..\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"ignoa-api\", uri!~\"/actuator.*\"}[$__rate_interval])), 1e-9)) or vector(0)",
          "legendFormat": "5xx 비율",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "응답 시간 p50 / p95 / p99",
      "description": "/actuator 요청은 제외. 성공(2xx·3xx) 응답만",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "eg0q0rxkuivwgc"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
