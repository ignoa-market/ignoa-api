      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eg0q0rxkuivwgc"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"ignoa-api\", uri!~\"/actuator.*\", outcome=~\"SUCCESS|REDIRECTION\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eg0q0rxkuivwgc"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"ignoa-api\", uri!~\"/actuator.*\", outcome=~\"SUCCESS|REDIRECTION\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eg0q0rxkuivwgc"
          },
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"ignoa-api\", uri!~\"/actuator.*\", outcome=~\"SUCCESS|REDIRECTION\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "range": true
        }
      ]
