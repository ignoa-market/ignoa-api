          "expr": "(sum(rate(http_server_requests_seconds_count{job=\"ignoa-api\", uri!~\"/actuator.*\", status=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_server_requests_seconds_count{job=\"ignoa-api\", uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "5xx 비율",
          "range": true
