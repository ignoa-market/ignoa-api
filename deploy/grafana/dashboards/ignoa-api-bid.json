          "datasource": {
            "type": "prometheus",
            "uid": "eg0q0rxkuivwgc"
          },
          "refId": "A",
          "expr": "sum by (outcome) (rate(lock_acquire_wait_seconds_count{application=\"ignoa-api\", operation=\"bid\", outcome=~\"timeout|infra_error\"}[$__rate_interval]))",
          "range": true,
          "legendFormat": "{{outcome}}"
