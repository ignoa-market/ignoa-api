      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "초당 입찰 결과 (outcome별)",
      "description": "accepted: 반영, price_conflict: 가격 경합·경매 종료 등으로 거절(409)",
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "eg0q0rxkuivwgc"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": 300000
          },
          "noValue": "수집 안 됨"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "accepted"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "price_conflict"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eg0q0rxkuivwgc"
          },
          "refId": "A",
          "expr": "sum by (outcome) (rate(bid_place_total{application=\"ignoa-api\"}[$__rate_interval]))",
          "range": true,
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "가격 경합 거절 비율",
      "description": "반영·가격 경합 거절 중 거절 비율. 요청이 없으면 0",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "eg0q0rxkuivwgc"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": 300000
          },
          "max": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eg0q0rxkuivwgc"
          },
          "refId": "A",
          "expr": "(sum(rate(bid_place_total{application=\"ignoa-api\", outcome=\"price_conflict\"}[$__rate_interval])) / clamp_min(sum(rate(bid_place_total{application=\"ignoa-api\"}[$__rate_interval])), 1e-9)) or vector(0)",
          "range": true,
          "legendFormat": "price_conflict"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "입찰 응답 시간 p50 / p95 / p99",
      "description": "POST /api/items/{itemId}/bids 전체 응답 시간(락 대기 포함)",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "eg0q0rxkuivwgc"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": 300000
          },
          "noValue": "최근 입찰 없음"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eg0q0rxkuivwgc"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"ignoa-api\", uri=\"/api/items/{itemId}/bids\", method=\"POST\"}[$__rate_interval]))) > 0",
          "range": true,
          "legendFormat": "p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eg0q0rxkuivwgc"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"ignoa-api\", uri=\"/api/items/{itemId}/bids\", method=\"POST\"}[$__rate_interval]))) > 0",
          "range": true,
          "legendFormat": "p95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eg0q0rxkuivwgc"
          },
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"ignoa-api\", uri=\"/api/items/{itemId}/bids\", method=\"POST\"}[$__rate_interval]))) > 0",
          "range": true,
          "legendFormat": "p99"
        }
      ]
    },
