{
  "uid": "ignoa-api-auction-close",
  "title": "ignoa-api / 경매 마감",
  "tags": [
    "ignoa",
    "api",
    "auction-close"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "editable": true,
  "panels": [
    {
      "type": "timeseries",
      "title": "마감 지연 (Polling 대기 포함)",
      "description": "경매 1건마다 종료부터 낙찰 확정까지 걸린 시간(폴링 대기 포함). 점선은 목표 10초",
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "eg0q0rxkuivwgc"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": 300000,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "noValue": "최근 마감 없음",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eg0q0rxkuivwgc"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(auction_close_lag_seconds_bucket{application=\"ignoa-api\"}[$__rate_interval]))) > 0",
          "range": true,
          "legendFormat": "p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eg0q0rxkuivwgc"
          },
          "refId": "C",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(auction_close_lag_seconds_bucket{application=\"ignoa-api\"}[$__rate_interval]))) > 0",
          "range": true,
          "legendFormat": "p95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eg0q0rxkuivwgc"
          },
          "refId": "D",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(auction_close_lag_seconds_bucket{application=\"ignoa-api\"}[$__rate_interval]))) > 0",
          "range": true,
          "legendFormat": "p99"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eg0q0rxkuivwgc"
          },
          "refId": "B",
          "expr": "max(auction_close_lag_seconds_max{application=\"ignoa-api\"}) > 0",
          "range": true,
          "legendFormat": "max"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "밀린 경매 수",
      "description": "종료됐지만 아직 마감되지 않은 경매 수. 계속 오르면 마감이 밀리는 중",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "eg0q0rxkuivwgc"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "noValue": "수집 안 됨",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eg0q0rxkuivwgc"
          },
          "refId": "A",
          "expr": "auction_close_backlog{application=\"ignoa-api\"}",
          "range": true,
          "legendFormat": "backlog"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "초당 마감 건수 (결과별)",
      "description": "skipped: 이미 마감됐거나 조건 불충족, failed: 다음 실행에서 재시도",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "eg0q0rxkuivwgc"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": 300000
          },
          "noValue": "최근 마감 없음"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eg0q0rxkuivwgc"
          },
          "refId": "A",
          "expr": "sum by (outcome) (rate(auction_close_items_total{application=\"ignoa-api\"}[$__rate_interval])) > 0",
          "range": true,
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "배치 1회 처리 시간 (최대 1,000건)",
      "description": "배치 1회(최대 1,000건)에 걸린 시간. 처리 건수에 따라 달라짐",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "eg0q0rxkuivwgc"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eg0q0rxkuivwgc"
          },
          "refId": "A",
          "expr": "sum(rate(auction_close_job_duration_seconds_sum{application=\"ignoa-api\"}[$__rate_interval])) / sum(rate(auction_close_job_duration_seconds_count{application=\"ignoa-api\"}[$__rate_interval]))",
          "range": true,
          "legendFormat": "avg"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eg0q0rxkuivwgc"
          },
          "refId": "B",
          "expr": "max(auction_close_job_duration_seconds_max{application=\"ignoa-api\"})",
          "range": true,
          "legendFormat": "max"
        }
      ]
    },
